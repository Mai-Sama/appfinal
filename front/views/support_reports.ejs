<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mis reportes | MaxGrade</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="bg-light">
    <main class="container py-5">
        <h2>Mis reportes de soporte</h2>
        <div id="reportsContainer" class="mt-4"></div>
    </main>

    <script>
        async function loadReports() {
            try {
                const res = await fetch('/api/support/my', { credentials: 'include' });
                if (!res.ok) throw new Error('No se pudo cargar');
                const data = await res.json();
                const container = document.getElementById('reportsContainer');
                if (!data || data.length === 0) {
                    container.innerHTML = '<div class="text-muted">No tienes reportes de soporte.</div>';
                    return;
                }
                container.innerHTML = data.map(r => `
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong>${new Date(r.fecha_creacion).toLocaleString()}</strong>
                                    <div class="text-muted">${r.tipo_problema}</div>
                                </div>
                                <div><span class="badge bg-secondary">${r.estado}</span></div>
                            </div>
                            <p class="mt-2">${r.descripcion || ''}</p>
                            ${r.url_evidencia ? `<p><a href="${r.url_evidencia}" target="_blank">Ver evidencia</a></p>` : ''}
                        </div>
                    </div>
                `).join('');
            } catch (err) {
                document.getElementById('reportsContainer').innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
            }
        }

        loadReports();
    </script>
</body>
</html>